{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Generator": {
    "MaxPageSize": 500
  },
  "SessionStore": {
    "Provider": "Memory",
    "IdleTimeout": "00:30:00",
    "MaxSessions": 10000
  },
  "ConnectionStrings": {
    "Redis": ""
  },
  "Auth": {
    "Mode": "GuestTokens",
    "Audience": "combination-generator-api",
    "Authority": "",
    "GuestIssuer": "combination-generator-api",
    "GuestTokenLifetime": "02:00:00",
    "AllowGuestTokensOutsideDevelopment": false
  },
  "RateLimiting": {
    "RequestsPerSecond": 20,
    "BurstLimit": 40,
    "GuestTokensPerMinute": 20
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
